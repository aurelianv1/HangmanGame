<Window x:Class="HangmanGame.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hangman Game" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewGameCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveGameCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenGameCommand}"/>
    </Window.InputBindings>

    <Grid Background="#880015">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" FontSize="12" Background="#6B0010" Foreground="White">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="File" Foreground="White">
                <MenuItem Header="New Game" Command="{Binding NewGameCommand}"/>
                <MenuItem Header="Open Game" Command="{Binding OpenGameCommand}"/>
                <MenuItem Header="Save Game" Command="{Binding SaveGameCommand}"/>
                <Separator/>
                <MenuItem Header="Statistics" Command="{Binding ShowStatisticsCommand}"/>
                <Separator/>
                <MenuItem Header="Cancel" Command="{Binding BackToLoginCommand}"/>
            </MenuItem>
            <MenuItem Header="Categories" Foreground="White">
                <MenuItem Header="All Categories"
                          Command="{Binding SelectCategoryCommand}"
                          CommandParameter="All Categories"/>
                <MenuItem Header="Cars"
                          Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Cars"/>
                <MenuItem Header="Movies"
                          Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Movies"/>
                <MenuItem Header="Rivers"
                          Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Rivers"/>
                <MenuItem Header="Countries"
                          Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Countries"/>
            </MenuItem>
            <MenuItem Header="Help" Foreground="White">
                <MenuItem Header="About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Level:" FontSize="14" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding CurrentLevel}" FontSize="20" FontWeight="Bold"
                           Foreground="#FFD700" Margin="0,0,0,15"/>
                <TextBlock Text="User:" FontSize="12" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Username}" FontSize="14"
                           Foreground="White" Margin="0,0,0,15"/>
                <Image Source="{Binding UserImage}" Width="150" Height="150"
                       Stretch="Uniform" Margin="0,0,0,20"/>
                <Image Source="{Binding HangmanImage}" Width="150" Height="200"
                       Stretch="Uniform"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0">
                <TextBlock Text="{Binding Category}" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="White"
                           Margin="0,0,0,15"/>
                <TextBlock Text="{Binding DisplayWord}" FontSize="28" FontWeight="Bold"
                           FontFamily="Courier New" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,30" Foreground="#FFD700"/>
                <ItemsControl ItemsSource="{Binding LetterButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.GuessLetterCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Width="35" Height="35" Margin="5" FontWeight="Bold"
                                    Background="White" Foreground="#880015"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding WrongGuesses, StringFormat=Greșeli: {0}/6}"
                           FontSize="14" HorizontalAlignment="Center"
                           Foreground="White" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Timp rămas:" FontSize="14" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding TimeRemaining, StringFormat={}{0:F1}s}"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#FFD700" Margin="0,0,0,20"/>
                <Button Content="New Game" Command="{Binding NewGameCommand}"
                        Height="35" Margin="0,0,0,10" FontSize="12"
                        Background="White" Foreground="#880015" FontWeight="Bold"/>
                <Button Content="Save Game" Command="{Binding SaveGameCommand}"
                        Height="35" Margin="0,0,0,10" FontSize="12"
                        Background="White" Foreground="#880015" FontWeight="Bold"/>
                <Button Content="Open Game" Command="{Binding OpenGameCommand}"
                        Height="35" FontSize="12"
                        Background="White" Foreground="#880015" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="2" Background="#6B0010" Padding="10">
            <TextBlock Text="Hangman Game - Good Luck!" Foreground="White"/>
        </StatusBar>
    </Grid>
</Window>
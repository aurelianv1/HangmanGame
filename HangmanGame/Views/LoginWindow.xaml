<Window x:Class="HangmanGame.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HangmanGame.ViewModels"
        Title="Hangman - Sign In" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#6B0010"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3D0008"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A00020"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#880015">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Welcome to Hangman! Don't die!"
                   FontSize="16" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>

        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Users}"
                     SelectedItem="{Binding SelectedUser}"
                     Background="#6B0010"
                     Foreground="White"
                     Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Username}" FontSize="14"
                                   Foreground="White" Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Image Source="{Binding PreviewImagePath}"
                       Width="150" Height="150"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&lt;&lt;" Width="50" Margin="5,0"
                            Command="{Binding PrevImageCommand}"/>
                    <Button Content="&gt;&gt;" Width="50" Margin="5,0"
                            Command="{Binding NextImageCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="10,15,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Background="#6B0010"
                     Foreground="White"
                     CaretBrush="White"
                     Margin="0,0,10,0"
                     Height="30"/>

            <Button Grid.Column="1" Content="Browse Image"
                    Command="{Binding BrowseImageCommand}"
                    Width="100" Height="30" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="New User"
                    Command="{Binding NewUserCommand}"
                    Width="80" Height="30"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,5,10,15">
            <Button Content="Delete User" Command="{Binding DeleteUserCommand}"
                    Width="90" Height="30" Margin="5,0"/>
            <Button Content="Play" Command="{Binding PlayCommand}"
                    Width="70" Height="30" Margin="5,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Width="70" Height="30" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="HangmanGame.Views.OpenGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deschide joc salvat" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Alege un joc salvat:"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="SavedGamesList"
                 ItemsSource="{Binding SavedGames}"
                 DisplayMemberPath="SaveName"
                 Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Deschide" Width="80" Height="30" Margin="5,0"
                    Click="OpenButton_Click"/>
            <Button Content="Anul" Width="80" Height="30" Margin="5,0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
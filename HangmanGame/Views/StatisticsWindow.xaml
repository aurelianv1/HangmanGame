<Window x:Class="HangmanGame.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistici" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Statistici utilizatori"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="StatsGrid"
                  ItemsSource="{Binding AllStats}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Utilizator" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Jocuri jucate" Binding="{Binding GamesPlayed}" Width="110"/>
                <DataGridTextColumn Header="Jocuri câștigate" Binding="{Binding GamesWon}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Închide" Width="80" Height="30"
                HorizontalAlignment="Right" Margin="0,15,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>